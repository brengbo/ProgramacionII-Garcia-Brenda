package Clase5;

public class CuentaBancaria {
    private String titular;
    private int numeroCuenta;
    private double saldo;

    public CuentaBancaria(String titular, int numeroCuenta, double saldo){ //constructor
        setTitular (titular); // para validar la restriccion del set, es un metodo
        this.numeroCuenta = numeroCuenta;
        setSaldo(saldo);
    }
    public String getTitular(){ //ver datos
        return titular;
    }
    public void setTitular (String titular){ //establecer valores, como objeto vacio o modificar valor
        if (titular == null || titular.trim().isEmpty()){
             throw new IllegalArgumentException("El titular no puede estar vacío.");
        } else {this.titular = titular;}
    }


    public int getNumeroCuenta(){
        return numeroCuenta;
    }
    public void setNumeroCuenta(int numeroCuenta){
        this.numeroCuenta= numeroCuenta;
    }



    public double getSaldo(){
        return saldo; 
    }
    public void setSaldo(double saldo){
        if(saldo<0){
            throw new IllegalArgumentException("El saldo no puede ser negativo.");
        } else {this.saldo = saldo;}
    }

//metodo depositar con validacion del monto
    public void depositar (double monto){ 
        if(monto<=0){
            throw new IllegalArgumentException( "El monto a depositar debe ser mayor a 0.");
        }
        this.saldo +=monto;}
    
    public void extraer(double monto){
        if (monto<=0){
            throw new IllegalArgumentException("El monto a extraer debe ser mayor a 0.");
        }
        if (monto>this.saldo){
            throw new IllegalArgumentException("El monto excede su saldo.");
        } this.saldo -=monto;}


//MAIN

    public static void main(String[] args) {
        CuentaBancaria cuenta1 = new CuentaBancaria("Brenda", 749630, 100000);
        System.out.println("Titular: " + cuenta1.getTitular());
        System.out.println("Número de cuenta: " + cuenta1.getNumeroCuenta());
        System.out.println("Saldo: " + cuenta1.getSaldo());


        try{
            cuenta1.setTitular(null);
        } catch (IllegalArgumentException e){
            System.out.println("No se puede ejecutar. Motivo: " + e.getMessage());
        }

        try{
            cuenta1.setSaldo(-5);
        } catch (IllegalArgumentException e){
            System.out.println("No se puede ejecutar. Motivo: " +e.getMessage());
        }


        //operacion valida de deposito

        try{
            cuenta1.depositar(600);
        } catch (IllegalArgumentException e){
            System.out.println("Excepcion: " + e.getMessage()); }

     //extracción valida
     try{
        cuenta1.extraer(400);
     } catch (IllegalArgumentException e){
            System.out.println("Excepción: " + e.getMessage());
        }

    //deposito invalido
    try{
        cuenta1.depositar(-1000);
    } catch (IllegalArgumentException e){
            System.out.println("Excepción: " + e.getMessage());
        }

    //extraccion invalida
    try{
        cuenta1.extraer(200000);
    }catch (IllegalArgumentException e){
        System.out.println("Excepción: " + e.getMessage());
    }

    }
}
